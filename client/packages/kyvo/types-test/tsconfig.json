{
  "compilerOptions": {
    "target": "es2022", "module": "esnext", "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": false,
    "jsx": "react", "jsxFactory": "h",
    "allowJs": false, "types": []
  },
  "include": ["*.tsx", "*.ts"]
}

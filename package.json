{
  "name": "preact-journal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpodwys/preact-journal.git"
  },
  "scripts": {
    "start": "gulp",
    "build": "gulp build",
    "serve": "gulp serve",
    "go": "npm run build && npm run serve",
    "test": "karma start test/karma.conf.js --single-run",
    "test:prod": "node test/build-prod-tests.js && karma start test/karma.prod.conf.js --single-run",
    "test:boot": "BOOT_SCENARIO=in karma start test/karma.boot.conf.js --single-run && BOOT_SCENARIO=out karma start test/karma.boot.conf.js --single-run",
    "test:boot-prod": "node test/run-boot-prod.js",
    "test:server": "node --test test/server/precompressed-static.spec.js",
    "test:artifact": "node test/run-artifact.js",
    "test:kyvo": "cd client/packages/kyvo/test && node build.js && karma start karma.conf.js && PROD=1 node build.js && karma start karma.conf.js && PROD=1 MANGLE=1 node build.js && karma start karma.conf.js",
    "test:examples": "cd client/packages/kyvo/examples/tasks && node build.js test && karma start karma.conf.js && PROD=1 node build.js test && karma start karma.conf.js",
    "test:types": "node client/packages/kyvo/types-test/run.js",
    "test:all": "npm test && npm run test:prod && npm run test:boot && npm run test:boot-prod && npm run test:server && npm run test:artifact && npm run test:kyvo && npm run test:examples"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "aws-ssl-profiles": "^1.1.2",
    "babel-loader": "^8.4.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.3",
    "browserslist": "^4.28.1",
    "compression": "^1.7.4",
    "cookie-parser": "1.4.1",
    "del": "^3.0.0",
    "dotenv": "1.2.0",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "express-jwt": "^5.3.3",
    "express-rate-limit": "^7.5.0",
    "force-ssl-heroku": "1.0.2",
    "gulp": "^4.0.0",
    "gulp-clean-css": "^3.9.2",
    "gulp-htmlmin": "^4.0.0",
    "gulp-inline-source": "^4.0.0",
    "gulp-replace": "^0.6.1",
    "gulp-terser": "^2.1.0",
    "idb-keyval": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "node-cron": "^4.2.1",
    "sequelize": "^6.37.5",
    "shrink-ray": "https://github.com/jpodwys/shrink-ray#master",
    "webpack": "^3.6.0"
  },
